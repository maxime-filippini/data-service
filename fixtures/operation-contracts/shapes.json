{
  "error": {
    "$defs": {
      "Issue": {
        "additionalProperties": false,
        "description": "One problem with a request, at a path such as `inputs.raw.id`.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "title": "Path",
            "type": "array"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "Issue",
        "type": "object"
      },
      "OperationFailure": {
        "additionalProperties": false,
        "description": "Why an operation failed. The caller retries `transient` failures and\nstops the run on `terminal` ones.",
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/$defs/Issue"
            },
            "title": "Issues",
            "type": "array"
          },
          "kind": {
            "enum": [
              "transient",
              "terminal"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "title": "OperationFailure",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The body of every non-2xx operation response.",
    "properties": {
      "error": {
        "$ref": "#/$defs/OperationFailure"
      }
    },
    "required": [
      "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
  },
  "operations": {
    "check-shapes": {
      "description": "Every field shape",
      "request": {
        "$defs": {
          "Equal": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "equal",
                "title": "Kind",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "title": "Equal",
            "type": "object"
          },
          "Fixed": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "fixed",
                "title": "Kind",
                "type": "string"
              },
              "weight": {
                "exclusiveMinimum": 0,
                "maximum": 1,
                "title": "Weight",
                "type": "number"
              }
            },
            "required": [
              "kind",
              "weight"
            ],
            "title": "Fixed",
            "type": "object"
          },
          "Frequency": {
            "enum": [
              "daily",
              "weekly"
            ],
            "title": "Frequency",
            "type": "string"
          },
          "Window": {
            "additionalProperties": false,
            "description": "A nested model, shared by both operations.",
            "properties": {
              "end": {
                "format": "date",
                "title": "End",
                "type": "string"
              },
              "start": {
                "format": "date",
                "title": "Start",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "title": "Window",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Every scalar and container shape, with camelCase aliases.",
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "count": {
            "maximum": 10,
            "minimum": 0,
            "title": "Count",
            "type": "integer"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "frequency": {
            "$ref": "#/$defs/Frequency"
          },
          "mode": {
            "enum": [
              "fast",
              "slow"
            ],
            "title": "Mode",
            "type": "string"
          },
          "nullableCount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nullablecount"
          },
          "optionalText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Optionaltext"
          },
          "pair": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Pair",
            "type": "array"
          },
          "path": {
            "pattern": "^runs/[a-z]+/[a-z]+\\.json$",
            "title": "Path",
            "type": "string"
          },
          "ratio": {
            "title": "Ratio",
            "type": "number"
          },
          "requiredText": {
            "maxLength": 8,
            "minLength": 1,
            "title": "Requiredtext",
            "type": "string"
          },
          "scheme": {
            "discriminator": {
              "mapping": {
                "equal": "#/$defs/Equal",
                "fixed": "#/$defs/Fixed"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Fixed"
              },
              {
                "$ref": "#/$defs/Equal"
              }
            ],
            "title": "Scheme"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "version": {
            "const": "v1",
            "title": "Version",
            "type": "string"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Weights",
            "type": "object"
          },
          "windows": {
            "items": {
              "$ref": "#/$defs/Window"
            },
            "title": "Windows",
            "type": "array"
          }
        },
        "required": [
          "requiredText",
          "nullableCount",
          "count",
          "ratio",
          "frequency",
          "mode",
          "version",
          "day",
          "at",
          "path",
          "tags",
          "windows",
          "weights",
          "pair",
          "scheme"
        ],
        "title": "ShapesRequest",
        "type": "object"
      },
      "response": {
        "$defs": {
          "Window": {
            "additionalProperties": false,
            "description": "A nested model, shared by both operations.",
            "properties": {
              "end": {
                "format": "date",
                "title": "End",
                "type": "string"
              },
              "start": {
                "format": "date",
                "title": "Start",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "title": "Window",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "maybeWindow": {
            "anyOf": [
              {
                "$ref": "#/$defs/Window"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "window": {
            "$ref": "#/$defs/Window"
          }
        },
        "required": [
          "window"
        ],
        "title": "ShapesResponse",
        "type": "object"
      }
    },
    "other-operation": {
      "description": "Shares a model with check-shapes",
      "request": {
        "$defs": {
          "EmptyParams": {
            "additionalProperties": false,
            "description": "No parameters.",
            "properties": {},
            "title": "EmptyParams",
            "type": "object"
          },
          "Window": {
            "additionalProperties": false,
            "description": "A nested model, shared by both operations.",
            "properties": {
              "end": {
                "format": "date",
                "title": "End",
                "type": "string"
              },
              "start": {
                "format": "date",
                "title": "Start",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "title": "Window",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "params": {
            "$ref": "#/$defs/EmptyParams"
          },
          "window": {
            "$ref": "#/$defs/Window"
          }
        },
        "required": [
          "window",
          "params"
        ],
        "title": "OtherRequest",
        "type": "object"
      },
      "response": {
        "additionalProperties": false,
        "properties": {
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total"
        ],
        "title": "OtherResponse",
        "type": "object"
      }
    }
  }
}
