{
	"name": "data-service",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:migrate:local": "wrangler d1 migrations apply data-service-market-data --local",
		"db:migrate:remote": "wrangler d1 migrations apply data-service-market-data --remote",
		"test": "node --import tsx --test test/*.test.*",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.3.7",
		"effect": "4.0.0-rc.118",
		"hono": "^4.13.12"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"wrangler": "^4.145.0"
	}
}
