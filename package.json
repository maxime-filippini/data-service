{
  "name": "data-service",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787 --var DASHBOARD_LOCAL_BYPASS:true",
    "deploy": "wrangler deploy --minify",
    "deploy:dev": "wrangler deploy --minify --env dev",
    "deploy:check": "wrangler deploy --dry-run --minify --containers-rollout=none --outdir .wrangler/dry-run && wrangler deploy --dry-run --minify --containers-rollout=none --outdir .wrangler/dry-run --env dev",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply data-service-market-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply data-service-market-data --remote",
    "db:migrate:dev": "wrangler d1 migrations apply data-service-market-data-dev --remote --env dev",
    "test": "node --import tsx --test test/*.test.*",
    "typecheck": "tsc --noEmit",
    "workflow:fixture": "node --import tsx scripts/workflow-fixture.ts",
    "workflow:trace": "node --import tsx scripts/workflow-trace.ts",
    "smoke:local": "node --import tsx scripts/cloudflare-smoke/local.ts",
    "workflow:migrate": "node --import tsx scripts/migrate-workflows.ts",
    "app:dev": "pnpm --filter app dev",
    "app:check": "pnpm --filter app check",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "engine:test": "uv run --directory containers/engine pytest",
    "engine:lint": "uv run --directory containers/engine ruff check src tests && uv run --directory containers/engine ruff format --check src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "operations:generate": "node --import tsx scripts/generate-operation-contracts.ts",
    "operations:check": "node --import tsx scripts/generate-operation-contracts.ts --check"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.6",
    "hono": "^4.13.12",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.6",
    "@types/node": "^26.6.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  }
}
