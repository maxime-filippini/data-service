/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-02",
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01,
		},
	},
	"upload_source_maps": true,
	"workers_dev": true,
	"preview_urls": false,
	// Hourly: starts the daily download once its hour has passed (see
	// download_schedule), and sweeps queued Parquet rebuilds at 02:00 UTC.
	"triggers": { "crons": ["0 * * * *"] },
	// The dashboard's built files (dashboard/dist/dashboard/* is served at
	// /dashboard/*). The Worker runs first so it can check Access before
	// serving them.
	"assets": {
		"directory": "./dashboard/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	"build": { "command": "pnpm --filter dashboard build" },
	// Bucket names for the containers (bindings don't expose them),
	// and the ingestion queue name so the consumer can tell its queues apart.
	"vars": {
		"RAW_BUCKET_NAME": "raw-market-data",
		"PROCESSED_BUCKET_NAME": "processed-market-data",
		"INGESTION_QUEUE_NAME": "market-data-ingestion",
	},
	"containers": [{
		"class_name": "MarketDataProcessor",
		"image": "./containers/processor/Dockerfile",
		"image_build_context": "./containers/processor",
		"max_instances": 1,
		"instance_type": "basic",
	}, {
		"class_name": "CalculationEngine",
		"image": "./containers/engine/Dockerfile",
		"image_build_context": "./containers/engine",
		"max_instances": 1,
		"instance_type": "basic",
	}],
	"durable_objects": {
		"bindings": [
			{ "name": "MARKET_DATA_PROCESSOR", "class_name": "MarketDataProcessor" },
			{ "name": "CALCULATION_ENGINE", "class_name": "CalculationEngine" },
		],
	},
	// One instance per run of the daily schedule; queues the downloads.
	"workflows": [{
		"name": "data-service-scheduled-downloads",
		"binding": "SCHEDULED_DOWNLOADS",
		"class_name": "ScheduledDownloadWorkflow",
	}],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MarketDataProcessor"] },
		{ "tag": "v2", "new_sqlite_classes": ["CalculationEngine"] },
	],
	"queues": {
		"producers": [
			{ "binding": "INGESTION_QUEUE", "queue": "market-data-ingestion" },
			{ "binding": "PROCESSING_QUEUE", "queue": "market-data-processing" },
		],
		"consumers": [{
			"queue": "market-data-ingestion",
			"max_batch_size": 5,
			"max_concurrency": 2,
			"max_retries": 3,
			"retry_delay": 60,
			"dead_letter_queue": "market-data-ingestion-dlq",
		}, {
			"queue": "market-data-processing",
			"max_batch_size": 1,
			"max_concurrency": 1,
			"max_retries": 3,
			"retry_delay": 300,
			"dead_letter_queue": "market-data-processing-dlq",
		}],
	},
	"r2_buckets": [
		{ "bucket_name": "raw-market-data", "binding": "MARKET_DATA_BUCKET" },
		{ "bucket_name": "processed-market-data", "binding": "PROCESSED_MARKET_DATA_BUCKET" },
	],
	"secrets": {
		"required": [
			"EODHD_API_TOKEN",
			"MANAGEMENT_API_TOKEN",
			"R2_ENDPOINT_URL",
			"R2_ACCESS_KEY_ID",
			"R2_SECRET_ACCESS_KEY",
			"ACCESS_TEAM_DOMAIN",
			"ACCESS_AUD",
			"DASHBOARD_ALLOWED_EMAILS",
		],
	},
	"d1_databases": [
		{
			"binding": "MARKET_DATA_DB",
			"database_name": "data-service-market-data",
			"database_id": "02d3dda4-f7b7-4bd1-a1db-e6e9a738b297",
		},
	],
	// Dev environment: CI deploys it from develop, feat/* and fix/*. Separate
	// Worker, database, buckets and queues. Bindings are not inherited from the
	// top level, so they repeat here.
	"env": {
		"dev": {
			"triggers": { "crons": [] },
			"assets": {
				"directory": "./dashboard/dist",
				"binding": "ASSETS",
				"run_worker_first": true,
			},
			"vars": {
				"RAW_BUCKET_NAME": "raw-market-data-dev",
				"PROCESSED_BUCKET_NAME": "processed-market-data-dev",
				"INGESTION_QUEUE_NAME": "market-data-ingestion-dev",
			},
			"containers": [{
				"class_name": "MarketDataProcessor",
				"image": "./containers/processor/Dockerfile",
				"image_build_context": "./containers/processor",
				"max_instances": 1,
				"instance_type": "basic",
			}, {
				"class_name": "CalculationEngine",
				"image": "./containers/engine/Dockerfile",
				"image_build_context": "./containers/engine",
				"max_instances": 1,
				"instance_type": "basic",
			}],
			"durable_objects": {
				"bindings": [
					{ "name": "MARKET_DATA_PROCESSOR", "class_name": "MarketDataProcessor" },
					{ "name": "CALCULATION_ENGINE", "class_name": "CalculationEngine" },
				],
			},
			"workflows": [{
				"name": "data-service-scheduled-downloads-dev",
				"binding": "SCHEDULED_DOWNLOADS",
				"class_name": "ScheduledDownloadWorkflow",
			}],
			"queues": {
				"producers": [
					{ "binding": "INGESTION_QUEUE", "queue": "market-data-ingestion-dev" },
					{ "binding": "PROCESSING_QUEUE", "queue": "market-data-processing-dev" },
				],
				"consumers": [{
					"queue": "market-data-ingestion-dev",
					"max_batch_size": 5,
					"max_concurrency": 2,
					"max_retries": 3,
					"retry_delay": 60,
					"dead_letter_queue": "market-data-ingestion-dev-dlq",
				}, {
					"queue": "market-data-processing-dev",
					"max_batch_size": 1,
					"max_concurrency": 1,
					"max_retries": 3,
					"retry_delay": 300,
					"dead_letter_queue": "market-data-processing-dev-dlq",
				}],
			},
			"r2_buckets": [
				{ "bucket_name": "raw-market-data-dev", "binding": "MARKET_DATA_BUCKET" },
				{ "bucket_name": "processed-market-data-dev", "binding": "PROCESSED_MARKET_DATA_BUCKET" },
			],
			"secrets": {
				"required": [
					"EODHD_API_TOKEN",
					"MANAGEMENT_API_TOKEN",
					"R2_ENDPOINT_URL",
					"R2_ACCESS_KEY_ID",
					"R2_SECRET_ACCESS_KEY",
					"ACCESS_TEAM_DOMAIN",
					"ACCESS_AUD",
					"DASHBOARD_ALLOWED_EMAILS",
				],
			},
			"d1_databases": [
				{
					"binding": "MARKET_DATA_DB",
					"database_name": "data-service-market-data-dev",
					"database_id": "7b4372d2-9175-408b-b2d2-3dea4de80359",
				},
			],
		},
	},
}
