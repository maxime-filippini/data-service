/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  // Deploying creates the DNS record and certificate. Cloudflare Access
  // protects the whole hostname except /api (the management API).
  "routes": [
    { "pattern": "data-service.maximefilippini.me", "custom_domain": true },
  ],
  // Hourly: reconciles active workflow runs and dispatches enabled workflow
  // assignments whose daily UTC hour has passed.
  "triggers": { "crons": ["0 * * * *"] },
  // The SvelteKit app's static files (dist/_app/*) and the docs (dist/docs/*,
  // served at /docs/*). The Worker runs first so it can check Access before
  // serving them.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // The app first: its build empties dist/ and writes the handler that
  // src/index.ts imports. Then the docs, copied into dist/docs/.
  "build": { "command": "pnpm --filter app build && pnpm --filter docs build" },
  // Bucket names for the Python container (bindings don't expose them).
  // WORKFLOW_DISPATCH: "on" lets the hourly cron dispatch workflow assignments
  // at their definitions' daily UTC hour; set "off" to pause all scheduled
  // dispatch without editing definitions.
  "vars": {
    "RAW_BUCKET_NAME": "raw-market-data",
    "PROCESSED_BUCKET_NAME": "processed-market-data",
    "WORKFLOW_DISPATCH": "on",
  },
  "containers": [
    {
      "class_name": "CalculationEngine",
      "image": "./containers/engine/Dockerfile",
      "image_build_context": "./containers/engine",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CALCULATION_ENGINE", "class_name": "CalculationEngine" },
    ],
  },
  // One instance per workflow-definition run (its instance ID is the run ID),
  // plus a durable batch dispatcher per hourly tick while WORKFLOW_DISPATCH is on.
  "workflows": [
    {
      "name": "data-service-workflow-runs",
      "binding": "WORKFLOW_RUNS",
      "class_name": "DefinitionRunWorkflow",
    },
    {
      "name": "data-service-workflow-dispatches",
      "binding": "WORKFLOW_DISPATCHES",
      "class_name": "WorkflowDispatchWorkflow",
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketDataProcessor"] },
    { "tag": "v2", "new_sqlite_classes": ["CalculationEngine"] },
    { "tag": "v3", "deleted_classes": ["MarketDataProcessor"] },
  ],
  "r2_buckets": [
    { "bucket_name": "raw-market-data", "binding": "MARKET_DATA_BUCKET" },
    {
      "bucket_name": "processed-market-data",
      "binding": "PROCESSED_MARKET_DATA_BUCKET",
    },
  ],
  "secrets": {
    "required": [
      "EODHD_API_TOKEN",
      "MANAGEMENT_API_TOKEN",
      "R2_ENDPOINT_URL",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD",
      "DASHBOARD_ALLOWED_EMAILS",
    ],
  },
  "d1_databases": [
    {
      "binding": "MARKET_DATA_DB",
      "database_name": "data-service-market-data",
      "database_id": "02d3dda4-f7b7-4bd1-a1db-e6e9a738b297",
    },
  ],
  // Dev environment: CI deploys it from develop, feat/* and fix/*. Separate
  // Worker, database, buckets and Workflow. Bindings are not inherited from
  // the top level, so they repeat here.
  "env": {
    "dev": {
      "triggers": { "crons": [] },
      "routes": [
        {
          "pattern": "data-service-dev.maximefilippini.me",
          "custom_domain": true,
        },
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      "vars": {
        "RAW_BUCKET_NAME": "raw-market-data-dev",
        "PROCESSED_BUCKET_NAME": "processed-market-data-dev",
        "WORKFLOW_DISPATCH": "on",
      },
      "containers": [
        {
          "class_name": "CalculationEngine",
          "image": "./containers/engine/Dockerfile",
          "image_build_context": "./containers/engine",
          "max_instances": 1,
          "instance_type": "basic",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CALCULATION_ENGINE", "class_name": "CalculationEngine" },
        ],
      },
      "workflows": [
        {
          "name": "data-service-workflow-runs-dev",
          "binding": "WORKFLOW_RUNS",
          "class_name": "DefinitionRunWorkflow",
        },
        {
          "name": "data-service-workflow-dispatches-dev",
          "binding": "WORKFLOW_DISPATCHES",
          "class_name": "WorkflowDispatchWorkflow",
        },
      ],
      "r2_buckets": [
        {
          "bucket_name": "raw-market-data-dev",
          "binding": "MARKET_DATA_BUCKET",
        },
        {
          "bucket_name": "processed-market-data-dev",
          "binding": "PROCESSED_MARKET_DATA_BUCKET",
        },
      ],
      "secrets": {
        "required": [
          "EODHD_API_TOKEN",
          "MANAGEMENT_API_TOKEN",
          "R2_ENDPOINT_URL",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "ACCESS_TEAM_DOMAIN",
          "ACCESS_AUD",
          "DASHBOARD_ALLOWED_EMAILS",
        ],
      },
      "d1_databases": [
        {
          "binding": "MARKET_DATA_DB",
          "database_name": "data-service-market-data-dev",
          "database_id": "7b4372d2-9175-408b-b2d2-3dea4de80359",
        },
      ],
    },
  },
}
